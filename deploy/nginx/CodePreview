map $http_upgrade $codepreview_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 16022 default_server;
    listen [::]:16022 default_server;

    server_name _;

    access_log /var/log/nginx/codepreview_access.log;
    error_log  /var/log/nginx/codepreview_error.log;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3022;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $codepreview_connection_upgrade;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
